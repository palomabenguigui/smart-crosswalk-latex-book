% hebrew.lbx – biblatex has no Hebrew localisation. The bibliography is typeset in English
% (IEEE), so the Hebrew language module simply inherits the English strings.
\ProvidesFile{hebrew.lbx}[2026/11/23 v0.1 smartcross: Hebrew -> English bibliography strings]
\InheritBibliographyExtras{english}
\InheritBibliographyStrings{english}
\endinput
